{
  "name": "iot_tracker_hono",
  "image": "oven/bun:1",
  "forwardPorts": [3000, 3001],
  "postCreateCommand": "bun install",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      }
    }
  }
}