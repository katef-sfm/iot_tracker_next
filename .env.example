NEXT_PUBLIC_API_SERVERS=https://iot-tracker.duo.cloud

DB_HOST=localhost
DB_USER=myuser
DB_PASS=mypassword

# @influxdata/influxdb3-client
INFLUX_HOST="localhost:8181"
INFLUX_DATABASE="iot_tracker"
INFLUX_TOKEN=""

VITE_INFLUXDB_HOST=<host>
VITE_INFLUXDB_DATABASE=<database>
VITE_INFLUXDB_TOKEN=<token>

# @influxdata/influxdb3-mcp-server
INFLUX_DB_INSTANCE_URL=http://localhost:8181/
INFLUX_DB_TOKEN=iot_tracker
INFLUX_DB_PRODUCT_TYPE=core
INFLUX_DB_TOKEN=your_database_token_here
